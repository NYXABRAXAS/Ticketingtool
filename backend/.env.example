# --- Runtime ---
NODE_ENV=production
PORT=10000

# --- Database (Render Postgres or Supabase connection string) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# --- Redmine ---
REDMINE_BASE_URL=
REDMINE_API_KEY=
REDMINE_TIMEOUT=30000
# Optional: shared secret configured on the Redmine side for webhook signature verification
REDMINE_WEBHOOK_SECRET=

# --- Secrets (generate strong random values, never commit real values) ---
TICKETING_JWT_SECRET=
LAUNCH_TOKEN_SECRET=
LOS_INTEGRATION_SECRET=
ADMIN_SESSION_SECRET=

# --- CORS: comma-separated list of LOS origins allowed to embed/launch this app ---
ALLOWED_ORIGINS=https://esaf-los.example.com,https://uat-los.example.com

# --- Sync ---
SYNC_ENABLED=true
SYNC_POLL_INTERVAL_MS=60000

# --- Launch token lifetime (seconds) ---
LAUNCH_TOKEN_TTL_SECONDS=300
SESSION_TTL_HOURS=8

# --- File upload limits ---
MAX_UPLOAD_MB=15

# --- Public URL of the deployed frontend (used to build launch URLs) ---
PUBLIC_APP_URL=https://your-ticketing-tool.onrender.com
